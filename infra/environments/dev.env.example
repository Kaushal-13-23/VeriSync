# =============================================================================
# VeriSync Environment Configuration: Development
# =============================================================================
NODE_ENV=development
API_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (Local Postgres Instance)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verisync_dev?schema=public&connection_limit=10&pool_timeout=10

# Security & Secrets (Development keys only - NEVER use in staging/prod)
JWT_ACCESS_SECRET=dev_verisync_jwt_access_secret_key_32_chars_min
JWT_REFRESH_SECRET=dev_verisync_jwt_refresh_secret_key_32_chars_min
SESSION_SECRET=dev_verisync_session_secret_key_32_chars_min

# Metrics & Observability
METRICS_ENABLED=true
LOG_LEVEL=debug
STRUCTURED_LOGGING=false

# Rate Limiting & Protections
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=1000
