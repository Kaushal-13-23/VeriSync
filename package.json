{
  "name": "verisync-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "dev:api": "pnpm --filter @verisync/api dev",
    "dev:admin": "pnpm --filter @verisync/admin-web dev",
    "dev:candidate": "pnpm --filter @verisync/candidate-desktop dev"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@prisma/client": "6.19.3",
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "6.19.3",
    "typescript": "^5.4.5"
  }
}
