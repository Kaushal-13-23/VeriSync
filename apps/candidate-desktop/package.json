{
  "name": "@verisync/candidate-desktop",
  "version": "1.1.0",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package:win": "tsc && vite build && electron-builder --win",
