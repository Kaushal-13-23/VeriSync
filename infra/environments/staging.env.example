# =============================================================================
# VeriSync Environment Configuration: Staging (Pre-Production & Regression)
# =============================================================================
NODE_ENV=staging
API_PORT=4000
CORS_ORIGIN=https://admin.staging.verisync.internal

# Database (Staging Postgres Cluster with PgBouncer / Connection Pool Tuning)
# Target pool sized for 250 candidate concurrency
DATABASE_URL=postgresql://staging_user:STAGING_STRONG_DB_PASSWORD@postgres.staging.internal:5432/verisync_staging?schema=public&connection_limit=30&pool_timeout=10&sslmode=require

# Security & Secrets (Loaded dynamically from Vault or AWS Secrets Manager)
# Rule 5: Passwords Argon2id only. Secrets must come from env/secret manager.
JWT_ACCESS_SECRET=vault:secret/verisync/staging/jwt_access_secret
JWT_REFRESH_SECRET=vault:secret/verisync/staging/jwt_refresh_secret
SESSION_SECRET=vault:secret/verisync/staging/session_secret

# Metrics & Observability (SRS 12.4)
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=info
STRUCTURED_LOGGING=true

# Rate Limiting & Protections
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=300
LOCKDOWN_STRICT_MODE=true
