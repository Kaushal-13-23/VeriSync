# =============================================================================
# VeriSync Environment Configuration: Production
# =============================================================================
NODE_ENV=production
API_PORT=4000
CORS_ORIGIN=https://admin.verisync.institution.edu

# High-Availability Database Connection Pool (Tuned for 500 candidate peak concurrency)
# NFR-PERF-001..003 pool tuning: connection_limit=60 per API instance, pool_timeout=5
DATABASE_URL=postgresql://verisync_prod_user:PROD_SECURE_PASSWORD@pgbouncer.prod.internal:6432/verisync_prod?schema=public&connection_limit=60&pool_timeout=5&sslmode=verify-full

# Security & Secrets (Loaded via Kubernetes Secrets / AWS Secrets Manager / HashiCorp Vault)
# Rule 5: Argon2id only. Zero plaintext secrets in repo or logs.
JWT_ACCESS_SECRET=vault:secret/verisync/prod/jwt_access_secret
JWT_REFRESH_SECRET=vault:secret/verisync/prod/jwt_refresh_secret
SESSION_SECRET=vault:secret/verisync/prod/session_secret

# High-Res Observability & Alerting (SRS 12.4)
METRICS_ENABLED=true
METRICS_PORT=9090
LOG_LEVEL=warn
STRUCTURED_LOGGING=true

# Strict Kiosk & Lab Protections (FR-LAB, FR-LOCK)
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=200
LOCKDOWN_STRICT_MODE=true
MAX_SESSION_EXPIRY_BATCH_SIZE=500
