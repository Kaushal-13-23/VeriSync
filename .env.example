# VeriSync Root Environment Variables Template

NODE_ENV=development

# Backend API Configuration
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verisync?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=verisync
POSTGRES_PORT=5432

# Security & Secrets (Argon2id / JWT)
JWT_ACCESS_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_64_character_hex_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Code Runner Service (Internal Auth)
CODE_RUNNER_PORT=5050
CODE_RUNNER_SHARED_SECRET=replace_with_internal_service_secret

# Frontend App Configs
VITE_API_BASE_URL=http://localhost:4000/api/v1
CANDIDATE_API_BASE_URL=http://localhost:4000/api/v1
