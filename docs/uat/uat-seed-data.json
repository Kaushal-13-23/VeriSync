      "topic": "Databases",
      "difficulty": "Medium",
      "maximumMarks": 10,
      "negativeMarks": 0,
      "questionText": "Write an SQL query to retrieve employee names and department names where the salary exceeds the department average salary.",
      "sqlConfig": {
        "schemaDdl": "CREATE TABLE employees (id INT PRIMARY KEY, name TEXT, department_id INT, salary INT); CREATE TABLE departments (id INT PRIMARY KEY, name TEXT);",
        "seedDataSql": "INSERT INTO departments VALUES (1, 'Engineering'), (2, 'Sales'); INSERT INTO employees VALUES (1, 'Rohan', 1, 95000), (2, 'Kavya', 1, 75000), (3, 'Aisha', 2, 85000), (4, 'Vikram', 2, 60000);",
        "referenceQuery": "SELECT e.name, d.name FROM employees e JOIN departments d ON e.department_id = d.id WHERE e.salary > (SELECT AVG(salary) FROM employees WHERE department_id = e.department_id) ORDER BY e.name ASC;",
        "comparisonMode": "EXACT_MATCH"
      }
    },
